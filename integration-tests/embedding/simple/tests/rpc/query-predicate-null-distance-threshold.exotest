operation:
  type: rpc
  payload: |
    {
      "method": "get_documents",
      "params": {
        "where": {"contentVector": {"similar": {"distanceTo": [0.95, 0.85, 0.15], "distance": {"lt": null}}}}
      }
    }
response: |
  {
    "error": {
      "code": -32001,
      "message": "Invalid field 'distance': The distance threshold must not be null"
    }
  }
