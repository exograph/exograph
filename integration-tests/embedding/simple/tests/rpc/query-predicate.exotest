stages:
  - operation:
      type: rpc
      payload: |
        {
          "method": "get_documents",
          "params": {
            "where": {"contentVector": {"similar": {"distanceTo": [0.95, 0.85, 0.15], "distance": {"lt": 0.5}}}},
            "orderBy": [{"id": "ASC"}]
          }
        }
    response: |
      {
        "result": [
          {"id": $.d1id, "title": "car", "content": "Car", "contentVector": [0.9, 0.8, 0.1]},
          {"id": $.d2id, "title": "motorcycle", "content": "Motorcycle", "contentVector": [0.8, 0.5, 0.1]},
          {"id": $.d4id, "title": "elephant", "content": "Elephant", "contentVector": [0.6, 0.9, 0.9]}
        ]
      }
  - operation:
      type: rpc
      payload: |
        {
          "method": "get_documents",
          "params": {
            "where": {"contentVector": {"similar": {"distanceTo": [0.95, 0.85, 0.15], "distance": {"gte": 0.5}}}},
            "orderBy": [{"id": "ASC"}]
          }
        }
    response: |
      {
        "result": [
          {"id": $.d3id, "title": "dog", "content": "Dog", "contentVector": [0.1, 0.1, 0.9]}
        ]
      }
