# `TeamSuggestion`'s rule has an alternative through the review team inside the
# `some(...)` body:
#
#   self.team.memberships.some(m => m.user.id == AuthContext.id || self.reviewTeam.active == true)
#
# A row without a review team (omitted, null, or a reference without its id) satisfies the rule
# only through a membership, so the precheck must not skip the body for a non-member.
stages:
  # A member of the team, without a review team, is allowed
  - operation:
      type: rpc
      payload: |
        {
          "method": "create_team_suggestion",
          "params": {
            "data": {"content": "by a member", "team": {"id": $.designTeamId}}
          }
        }
    auth: |
      {
        "sub": $.daveDesignerId
      }
    response: |
      {
        "result": {
          "id": 1
        }
      }
  # A non-member, with the review team omitted, is rejected
  - operation:
      type: rpc
      payload: |
        {
          "method": "create_team_suggestion",
          "params": {
            "data": {"content": "omitted review team", "team": {"id": $.designTeamId}}
          }
        }
    auth: |
      {
        "sub": $.aliceEngineerId
      }
    response: |
      {
        "error": {
          "code": -32004,
          "message": "Not authorized"
        }
      }
  # A non-member, with a null review team, is rejected
  - operation:
      type: rpc
      payload: |
        {
          "method": "create_team_suggestion",
          "params": {
            "data": {"content": "null review team", "team": {"id": $.designTeamId}, "reviewTeam": null}
          }
        }
    auth: |
      {
        "sub": $.aliceEngineerId
      }
    response: |
      {
        "error": {
          "code": -32004,
          "message": "Not authorized"
        }
      }
  # A non-member, with a review team without its id, is rejected
  - operation:
      type: rpc
      payload: |
        {
          "method": "create_team_suggestion",
          "params": {
            "data": {"content": "review team without its id", "team": {"id": $.designTeamId}, "reviewTeam": {}}
          }
        }
    auth: |
      {
        "sub": $.aliceEngineerId
      }
    response: |
      {
        "error": {
          "code": -32004,
          "message": "Not authorized"
        }
      }
