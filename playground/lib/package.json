    "@clerk/clerk-react": "5.61.9",
    "@clerk/themes": "2.4.64",
    "@graphiql/plugin-explorer": "5.1.5",
    "@graphiql/toolkit": "0.12.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "ai": "^7.0.148",
    "graphiql": "5.4.0",
